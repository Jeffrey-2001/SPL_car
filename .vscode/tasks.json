{
    // ========================================================================
    // VSCode 任务配置文件 (Tasks Configuration)
    // ========================================================================
    // 该文件定义了可从 VSCode 执行的构建任务
    // 通过 Ctrl+Shift+P 输入 "Tasks: Run Task" 或使用快捷键执行
    // ========================================================================

    "version": "2.0.0",

    "tasks": [
        {
            // ================================================================
            // 任务 1: 编译项目（生成 ELF/HEX/BIN 文件）
            // ================================================================
            // 执行 make 命令编译整个项目
            // 对应 makefile 中的 'all' 目标
            //
            // 使用方法:
            //   1. 按 Ctrl+Shift+P
            //   2. 输入 "Tasks: Run Task"
            //   3. 选择 "编译项目"
            //
            // 输出文件:
            //   - build/test01.elf  (可执行文件，用于调试)
            //   - build/test01.hex  (Intel HEX 格式，用于烧录)
            //   - build/test01.bin  (二进制格式，用于烧录)
            // ================================================================

            "label": "编译项目",
            "type": "shell",
            "command": "make",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // ================================================================
            // 任务分组
            // ================================================================
            // "build" = 构建任务
            // "isDefault": true = 该组中的默认任务
            // 按 Ctrl+Shift+B 会直接执行默认构建任务
            // ================================================================

            "problemMatcher": "$gcc",
            // ================================================================
            // 问题匹配器
            // ================================================================
            // "$gcc" = 使用 GCC 的错误/警告格式解析输出
            // VSCode 会自动将编译错误显示在"问题"面板中
            // 点击错误可以直接跳转到对应代码位置
            // ================================================================

            "detail": "使用 make 编译 STM32 项目，生成 ELF/HEX/BIN 文件"
            // ================================================================
            // 任务详细描述
            // ================================================================
            // 在任务选择对话框中显示
            // ================================================================
        },

        {
            // ================================================================
            // 任务 2: 清理编译产物
            // ================================================================
            // 删除 build 目录中的所有编译生成文件
            // 对应 makefile 中的 'clean' 目标
            //
            // 使用场景:
            //   - 编译结果异常时，清理后重新编译
            //   - 切换分支或更新代码后，确保干净编译
            //
            // 被删除的文件类型:
            //   - *.o: 编译的目标文件
            //   - *.d: 依赖文件
            //   - *.lst: 汇编列表文件
            //   - *.elf: 可执行文件
            //   - *.hex: HEX 文件
            //   - *.bin: 二进制文件
            //   - *.map: 链接映射文件
            // ================================================================

            "label": "清理项目",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": [],
            // ================================================================
            // 问题匹配器
            // ================================================================
            // 空数组 = 不解析错误输出（清理任务通常没有错误）
            // ================================================================

            "detail": "删除 build 目录中的所有编译生成文件"
        },

        {
            // ================================================================
            // 任务 3: 烧录到 STM32（使用 OpenOCD + ST-Link）
            // ================================================================
            // 使用 OpenOCD 通过 ST-Link 将程序烧录到 STM32 芯片
            // 对应 makefile 中的 'flash' 目标
            //
            // 前置条件:
            //   1. STM32 开发板通过 ST-Link 连接到电脑
            //   2. 已安装 OpenOCD (macOS: brew install openocd)
            //   3. 已编译生成 HEX/BIN 文件
            //
            // 烧录过程:
            //   1. 自动执行编译任务（确保最新代码）
            //   2. 连接到 ST-Link
            //   3. 将 .bin 文件烧录到 Flash 起始地址 0x8000000
            //   4. 验证烧录结果
            //   5. 复位芯片
            //
            // OpenOCD 参数说明:
            //   - interface/stlink.cfg: ST-Link 接口配置
            //   - target/stm32f1x.cfg: STM32F1 系列芯片配置
            //   - program ...: 烧录命令
            //   - verify: 验证烧录内容
            //   - reset: 复位芯片
            //   - exit: 退出 OpenOCD
            // ================================================================

            "label": "烧录到 STM32 (ST-Link)",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "dependsOn": ["编译项目"],
            // ================================================================
            // 依赖任务
            // ================================================================
            // 烧录前先执行编译任务
            // 确保烧录的是最新编译的代码
            // ================================================================

            "problemMatcher": [],
            "detail": "使用 OpenOCD 和 ST-Link 将程序烧录到 STM32F103"
        },

        {
            // ================================================================
            // 任务 4: 烧录到 STM32（使用 J-Link）
            // ================================================================
            // 使用 J-Link 工具链将程序烧录到 STM32 芯片
            // 对应 makefile 中的 'flash_jlink' 目标
            //
            // 前置条件:
            //   1. STM32 开发板通过 J-Link 连接到电脑
            //   2. 已安装 J-Link Software Pack
            //   3. 已准备 flash.jlink 脚本文件（需要手动创建）
            //
            // 注意:
            //   需要在项目根目录创建 flash.jlink 脚本文件
            //   示例 flash.jlink 内容:
            //     connect
            //     loadbin build/test01.bin 0x8000000
            //     r
            //     g
            //     exit
            // ================================================================

            "label": "烧录到 STM32 (J-Link)",
            "type": "shell",
            "command": "make",
            "args": ["flash_jlink"],
            "dependsOn": ["编译项目"],
            "problemMatcher": [],
            "detail": "使用 J-Link 将程序烧录到 STM32F103"
        },

        {
            // ================================================================
            // 任务 5: 仅编译（不自动烧录）
            // ================================================================
            // 执行 make 命令编译项目，但不进行烧录
            // 用于检查代码是否有编译错误
            //
            // 与"编译项目"任务的差异:
            //   - 本任务不是默认构建任务
            //   - 功能相同，只是区分用途
            // ================================================================

            "label": "编译检查",
            "type": "shell",
            "command": "make",
            "args": [],
            "problemMatcher": "$gcc",
            "detail": "编译项目但不烧录，用于检查编译错误"
        },

        {
            // ================================================================
            // 任务 6: 显示编译信息
            // ================================================================
            // 显示编译后生成的文件大小信息
            // 帮助了解 Flash 和 RAM 使用情况
            //
            // 输出示例:
            //   text    data     bss     dec     hex filename
            //   1024      56     256    1336     538 build/test01.elf
            //
            // 说明:
            //   - text: 代码段大小（Flash 占用）
            //   - data: 已初始化数据段大小（Flash+RAM 占用）
            //   - bss: 未初始化数据段大小（RAM 占用）
            //   - dec/hex: 总大小（十进制/十六进制）
            //
            // STM32F103C8T6 资源:
            //   - Flash: 64KB (0x10000)
            //   - RAM: 20KB (0x5000)
            // ================================================================

            "label": "显示程序大小",
            "type": "shell",
            "command": "make",
            "args": ["size"],
            // ================================================================
            // 注意: makefile 中需要添加 size 目标
            // 或直接使用 arm-none-eabi-size 命令
            // ================================================================

            "problemMatcher": [],
            "dependsOn": ["编译项目"],
            "detail": "显示编译后程序在 Flash 和 RAM 中的占用大小"
        }
    ]
}