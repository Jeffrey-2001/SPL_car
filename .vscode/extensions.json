{
    // ========================================================================
    // VSCode 推荐扩展配置文件 (Extensions Recommendations)
    // ========================================================================
    // 该文件定义了当前工作区推荐的 VSCode 扩展
    // 打开工作区时，VSCode 会提示安装这些扩展
    // ========================================================================

    "recommendations": [
        // ================================================================
        // 1. C/C++ 扩展 - Microsoft 官方提供
        // ================================================================
        // 扩展 ID: ms-vscode.cpptools
        //
        // 功能:
        //   - C/C++ 代码 IntelliSense（智能代码补全）
        //   - 语法高亮和着色
        //   - 代码导航（跳转到定义/声明）
        //   - 错误和警告检测
        //   - 代码格式化
        //   - 头文件包含路径配置
        //
        // 适用场景:
        //   - STM32 C/C++ 项目必备
        //   - 提供 c_cpp_properties.json 配置支持
        //   - IntelliSense 依赖于配置文件中的包含路径和宏定义
        // ================================================================

        "ms-vscode.cpptools",

        // ================================================================
        // 2. Cortex-Debug 扩展 - ARM Cortex-M 调试专用
        // ================================================================
        // 扩展 ID: marus25.cortex-debug
        //
        // 功能:
        //   - 支持 Cortex-M0/M3/M4/M7 系列调试
        //   - 支持 ST-Link、J-Link、CMSIS-DAP 等调试器
        //   - 实时变量查看和修改
        //   - 寄存器查看（结合 SVD 文件）
        //   - 外设寄存器位定义显示
        //   - 内存查看器
        //   - 反汇编查看
        //   - 断点管理（硬件/软件断点）
        //
        // 调试器支持:
        //   - OpenOCD (开源，推荐)
        //   - J-Link GDB Server
        //   - ST-Link GDB Server
        //   - PyOCD
        //
        // 适用场景:
        //   - STM32 系列单片机调试必备
        //   - 提供 launch.json 调试配置支持
        //   - 支持查看外设寄存器的位定义（需 SVD 文件）
        // ================================================================

        "marus25.cortex-debug",

        // ================================================================
        // 3. ARM 调试扩展 - ARM 官方提供（可选）
        // ================================================================
        // 扩展 ID: ARM.arm-debug
        //
        // 功能:
        //   - ARM 官方调试支持
        //   - 与 Keil MDK 和 IAR 集成
        //   - ARM Compiler 工具链支持
        //
        // 适用场景:
        //   - 使用 ARM Compiler 而非 GCC 的项目
        //   - 需要与 Keil/IAR 集成的场景
        //   - Cortex-Debug 更通用，本项目中优先使用 Cortex-Debug
        // ================================================================

        "ARM.arm-debug",

        // ================================================================
        // 4. C/C++ Makefile 扩展
        // ================================================================
        // 扩展 ID: twxs.cmake (CMake 支持，可选)
        // 扩展 ID: ms-vscode.makefile-tools (Makefile 支持)
        //
        // 功能:
        //   - Makefile 语法高亮
        //   - Makefile 代码补全
        //   - 快速跳转到 Makefile 目标
        //   - 错误检测
        //
        // 适用场景:
        //   - 本项目使用 Makefile 构建系统
        //   - 方便编辑和查看 makefile
        //   - 有助于理解构建过程
        // ================================================================

        "ms-vscode.makefile-tools",

        // ================================================================
        // 5. C/C++ 扩展包 - 增强功能（可选）
        // ================================================================
        // 扩展 ID: danielpinto8zz6.c-cpp-compile-run
        //
        // 功能:
        //   - 快速编译运行 C/C++ 代码
        //   - 一键运行当前文件
        //   - 自动检测编译器
        //
        // 适用场景:
        //   - 桌面端 C/C++ 快速测试
        //   - 注意: 不适用于嵌入式交叉编译
        //   - 本项目主要使用 tasks.json 中的编译任务
        // ================================================================

        "danielpinto8zz6.c-cpp-compile-run",

        // ================================================================
        // 6. Code Spell Checker - 代码拼写检查（可选）
        // ================================================================
        // 扩展 ID: streetsidesoftware.code-spell-checker
        //
        // 功能:
        //   - 实时拼写检查
        //   - 检测变量名、注释中的拼写错误
        //   - 支持自定义字典
        //
        // 适用场景:
        //   - 减少注释中的拼写错误
        //   - 提高代码文档质量
        //   - 嵌入式开发中英文注释常见，拼写检查有帮助
        // ================================================================

        "streetsidesoftware.code-spell-checker",

        // ================================================================
        // 7. GitLens - Git 增强（可选）
        // ================================================================
        // 扩展 ID: eamodio.gitlens
        //
        // 功能:
        //   - 显示代码的 Git 提交历史
        //   - 查看作者和提交信息
        //   - 代码比较和回滚
        //   - 分支可视化
        //
        // 适用场景:
        //   - 使用 Git 进行版本控制的项目
        //   - 团队协作时了解代码变更
        //   - 审查代码历史
        // ================================================================

        "eamodio.gitlens",

        // ================================================================
        // 8. Better Comments - 更好的注释（可选）
        // ================================================================
        // 扩展 ID: aaron-bond.better-comments
        //
        // 功能:
        //   - 彩色注释高亮
        //   - 支持不同类型注释的颜色标记
        //   - 注释分类（警告、提示、待办等）
        //
        // 使用示例:
        //   // ! 重要提醒
        //   // ? 待确认的问题
        //   // TODO 待办事项
        //   // * 注意事项
        //
        // 适用场景:
        //   - 提高代码可读性
        //   - 标记重要代码段
        //   - 团队代码审查
        // ================================================================

        "aaron-bond.better-comments",

        // ================================================================
        // 9. Bracket Pair Colorizer - 括号颜色化
        // ================================================================
        // 扩展 ID: CoenraadS.bracket-pair-colorizer-2
        //
        // 功能:
        //   - 不同层级的括号使用不同颜色
        //   - 便于识别代码块嵌套关系
        //   - 支持圆括号、方括号、大括号
        //
        // 适用场景:
        //   - 嵌套层级复杂的代码
        //   - 快速定位括号匹配
        //   - 减少括号匹配错误
        //
        // 注意: VSCode 1.60+ 内置了此功能，无需额外安装
        // ================================================================

        "CoenraadS.bracket-pair-colorizer-2",

        // ================================================================
        // 10. Import Cost - 导入成本（C/C++ 较少用）
        // ================================================================
        // 扩展 ID: wix.vscode-import-cost
        //
        // 功能:
        //   - 显示引入头文件的"成本"
        //   - 分析头文件包含的复杂度
        //
        // 适用场景:
        //   - 优化编译时间
        //   - 减少头文件依赖
        //   - C/C++ 项目中可以用来识别大文件引入
        // ================================================================

        "wix.vscode-import-cost",

        // ================================================================
        // 11. TODO Highlight - 待办事项高亮（可选）
        // ================================================================
        // 扩展 ID: wayou.vscode-todo-highlight
        //
        // 功能:
        //   - 高亮代码中的 TODO、FIXME 等标记
        //   - 快速跳转到待办事项
        //   - 可自定义关键词
        //
        // 适用场景:
        //   - 跟踪未完成的工作
        //   - 代码审查时注意待办事项
        //   - 项目管理
        // ================================================================

        "wayou.vscode-todo-highlight",

        // ================================================================
        // 12. Hex Editor - 十六进制编辑器（可选）
        // ================================================================
        // 扩展 ID: ms-vscode.hexeditor
        //
        // 功能:
        //   - 以十六进制查看和编辑文件
        //   - 支持多种编码
        //   - 数据校验和计算
        //
        // 适用场景:
        //   - 查看 .bin / .hex 文件内容
        //   - 分析固件结构
        //   - 调试数据传输问题
        // ================================================================

        "ms-vscode.hexeditor",

        // ================================================================
        // 13. Serial Monitor - 串口监视器（可选）
        // ================================================================
        // 扩展 ID: ms-vscode.vscode-serial-monitor
        //
        // 功能:
        //   - 在 VSCode 内查看串口输出
        //   - 支持多种波特率
        //   - 发送数据到串口
        //
        // 适用场景:
        //   - 调试串口打印信息（printf/uart_printf）
        //   - 无需额外打开终端或串口工具
        //   - STM32 调试常用（UART 输出调试信息）
        //
        // 使用方式:
        //   - 按 Ctrl+Shift+P
        //   - 输入 "Serial Monitor: Open Serial Port"
        //   - 选择串口和波特率
        // ================================================================

        "ms-vscode.vscode-serial-monitor"
    ],

    // ================================================================
    // 不推荐的扩展（可选配置）
    // ================================================================
    // 列出与本工作区冲突或不推荐的扩展
    // ================================================================

    "unwantedRecommendations": [
        // 例如: 与 C/C++ 扩展冲突的其他扩展
        "some.other-extension"
    ]
}