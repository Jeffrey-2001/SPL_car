{
    // ========================================================================
    // VSCode 工作区设置 (Workspace Settings)
    // ========================================================================
    // 该文件定义了当前工作区的 VSCode 配置
    // 这些设置会覆盖用户设置 (User Settings)，但仅对当前项目生效
    // ========================================================================

    "files.associations": {
        // ====================================================================
        // 文件关联设置 - 将特定后缀的文件关联为 C 语言
        // ====================================================================
        // STM32 嵌入式项目中，头文件可能使用 .h、.hpp 等后缀
        // 将这些文件关联为 C 语言，以便正确识别语法和高亮
        // ====================================================================

        "*.h": "c",
        "*.s": "asm"
    },

    "editor.tabSize": 4,
    // ================================================================
    // 编辑器缩进设置
    // ================================================================
    // 设置制表符宽度为 4 个空格
    // 嵌入式开发中通常使用 4 空格缩进，符合大多数嵌入式项目的代码规范
    // ================================================================

    "editor.insertSpaces": false,
    // ================================================================
    // 使用制表符而非空格缩进
    // ================================================================
    // false = 使用制表符 (Tab)
    // true = 使用空格
    // 嵌入式项目通常使用制表符，因为文件大小敏感（Flash 容量有限）
    // ================================================================

    "editor.formatOnSave": false,
    // ================================================================
    // 保存时自动格式化
    // ================================================================
    // false = 不自动格式化（建议手动格式化，避免意外修改）
    // true = 保存时自动格式化
    // 嵌入式代码有时有特定对齐要求（如寄存器位定义），自动格式化可能破坏
    // ================================================================

    "editor.detectIndentation": false,
    // ================================================================
    // 禁用自动缩进检测
    // ================================================================
    // false = 不自动检测文件缩进格式，使用 settings.json 中的配置
    // true = 根据文件内容自动检测缩进
    // 确保整个项目使用统一的缩进风格
    // ================================================================

    "editor.rulers": [80, 120],
    // ================================================================
    // 编辑器标尺位置
    // ================================================================
    // 在 80 和 120 列位置显示垂直参考线
    // 80 列是传统标准（适合终端显示），120 列是现代宽屏标准
    // 嵌入式项目通常控制在 80-120 列内，便于代码审查和查看
    // ================================================================

    "files.encoding": "utf8",
    // ================================================================
    // 文件编码格式
    // ================================================================
    // 统一使用 UTF-8 编码
    // 避免中文注释乱码问题
    // ================================================================

    "files.eol": "\n",
    // ================================================================
    // 文件换行符格式
    // ================================================================
    // "\n" = LF (Linux/macOS 风格，推荐)
    // "\r\n" = CRLF (Windows 风格)
    // 嵌入式开发通常在 Linux 环境进行，使用 LF 换行符
    // ================================================================

    "files.exclude": {
        // ================================================================
        // 文件排除设置 - 隐藏不需要查看的文件
        // ================================================================
        // 这些文件不会显示在文件浏览器中，减少干扰
        // 可随时通过 "Show All Files" 按钮查看
        // ================================================================

        "**/.git": true,           // Git 版本控制目录
        "**/.DS_Store": true,      // macOS 系统文件
        "**/*.o": true,            // 编译生成的目标文件
        "**/*.d": true,            // 编译依赖文件
        "**/*.lst": true,          // 汇编列表文件
        "**/*.map": true,          // 链接映射文件
        "**/*.elf": true,          // ELF 可执行文件
        "**/*.hex": true,          // Intel HEX 文件
        "**/*.bin": true,          // 二进制文件
        "**/build/**": true       // build 目录下所有文件
    },

    "search.exclude": {
        // ================================================================
        // 搜索排除设置 - 搜索时忽略这些文件/目录
        // ================================================================
        // 提高搜索速度，避免搜索不需要的文件
        // ================================================================

        "**/build/**": true,       // 编译输出目录
        "**/*.o": true,            // 目标文件
        "**/*.d": true,            // 依赖文件
        "**/*.lst": true,          // 汇编列表文件
        "**/*.map": true           // 映射文件
    },

    "C_Cpp.intelliSenseEngine": "default",
    // ================================================================
    // C/C++ IntelliSense 引擎选择
    // ================================================================
    // "default" = 使用新的 IntelliSense 引擎（更快、更准确）
    // "tag-parser" = 旧的标签解析引擎（兼容性更好）
    // 嵌入式项目使用 default 引擎效果更好
    // ================================================================

    "C_Cpp.errorSquiggles": "enabled",
    // ================================================================
    // 代码错误波浪线显示
    // ================================================================
    // "enabled" = 显示错误和警告波浪线
    // "disabled" = 不显示波浪线
    // "underlineOnly" = 只显示下划线
    // ================================================================

    "C_Cpp.autocomplete": "default",
    // ================================================================
    // C/C++ 代码补全设置
    // ================================================================
    // "default" = 默认补全行为
    // "disabled" = 禁用自动补全
    // ================================================================

    "cortex-debug.armToolchainPath": "/usr/local/bin",
    // ================================================================
    // Cortex Debug 调试器工具链路径
    // ================================================================
    // 指定 arm-none-eabi-gcc 等工具的安装路径
    // macOS 通常在 /usr/local/bin 或通过 brew 安装
    // Linux 通常在 /usr/bin
    // Windows 需要指定完整路径，如: "C:/gcc-arm-none-eabi/bin"
    // 如果 arm-none-eabi-gcc 在 PATH 中，可以留空或不设置
    // ================================================================

    "cortex-debug.openocdPath": "/usr/local/bin/openocd",
    // ================================================================
    // OpenOCD 调试器路径
    // ================================================================
    // OpenOCD 用于 STM32 烧录和调试
    // macOS: 使用 brew 安装后通常在 /usr/local/bin/openocd
    // Linux: /usr/bin/openocd
    // Windows: 需要指定完整路径
    // 如果不使用 OpenOCD 调试，可以不设置此项
    // ================================================================

    "files.watcherExclude": {
        // ================================================================
        // 文件监视器排除设置
        // ================================================================
        // 这些目录的文件变更不会被监视
        // 减少 VSCode 资源占用，提高性能
        // ================================================================

        "**/build/**": true
    }
}